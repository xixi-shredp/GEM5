def template MatrixDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template MatrixMacroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      public:
        %(class_name)s(ExtMachInst machInst);
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template MatrixMacroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        StaticInstPtr cur_inst;
        %(microop_setup)s;
        microops.front()->setFirstMicroop();
        microops.back()->setLastMicroop();
    }

    std::string
    %(class_name)s::generateDisassembly(Addr pc,
        const loader::SymbolTable *symtab) const
    {
        return mnemonic;
    }
}};

def template MatrixExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;
        %(op_wb)s;
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(Addr pc,
        const loader::SymbolTable *symtab) const
    {
        return mnemonic;
    }
}};

def template MatrixLoadRowMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      public:
        %(class_name)s(
            ExtMachInst machInst, uint8_t rowIdx,
            std::shared_ptr<RiscvISA::MatLoadState> state,
            bool commitResult);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(
            PacketPtr, ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr, const loader::SymbolTable *) const override;

      private:
        RegId srcRegIdxArr[2];
        RegId destRegIdxArr[1];
        const uint8_t rowIdx;
        const std::shared_ptr<RiscvISA::MatLoadState> state;
        const bool commitResult;
    };
}};

def template MatrixLoadRowMicroConstructor {{
    %(class_name)s::%(class_name)s(
        ExtMachInst machInst, uint8_t rowIdx,
        std::shared_ptr<RiscvISA::MatLoadState> state,
        bool commitResult)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s),
          rowIdx(rowIdx), state(std::move(state)),
          commitResult(commitResult)
    {
        setRegIdxArrays(
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
        setSrcRegIdx(_numSrcRegs++, intRegClass[machInst.rs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[machInst.rs2]);
        if (commitResult) {
            setDestRegIdx(_numDestRegs++, matRegClass[MREG]);
            _numTypedDestRegs[matRegClass.type()]++;
        }
        memAccessFlags = (Request::Flags)(%(mem_align)s);
        flags[IsLoad] = true;
        flags[IsMatrix] = true;
        flags[IsInteger] = true;
    }
}};

def template MatrixLoadRowMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        const auto base = xc->getRegOperand(this, 0);
        const auto stride = xc->getRegOperand(this, 1);
        const Addr ea = rvSext(base + rowIdx * stride);
        static const std::vector<bool> byte_enable(
            RiscvISA::MatRowByteCount, true);
        RiscvISA::MatRowBytes bytes = {};
        Fault fault = xc->readMem(
            ea, bytes.data(), RiscvISA::MatRowByteCount,
            memAccessFlags, byte_enable);
        if (fault != NoFault) {
            return fault;
        }

        deserializeMatWordRow(bytes, state->tile, rowIdx);
        if (commitResult) {
            xc->setRegOperand(this, 0, &state->tile);
        }
        return NoFault;
    }

    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        const auto base = xc->getRegOperand(this, 0);
        const auto stride = xc->getRegOperand(this, 1);
        const Addr ea = rvSext(base + rowIdx * stride);
        static const std::vector<bool> byte_enable(
            RiscvISA::MatRowByteCount, true);
        return xc->initiateMemRead(
            ea, RiscvISA::MatRowByteCount, memAccessFlags, byte_enable);
    }

    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        RiscvISA::MatRowBytes bytes = {};
        const auto *pkt_data = pkt->getConstPtr<uint8_t>();
        for (std::size_t i = 0; i < RiscvISA::MatRowByteCount; ++i) {
            bytes[i] = pkt_data[i];
        }
        deserializeMatWordRow(bytes, state->tile, rowIdx);
        if (commitResult) {
            xc->setRegOperand(this, 0, &state->tile);
        }
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        return mnemonic;
    }
}};

def template MatrixStoreRowMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      public:
        %(class_name)s(
            ExtMachInst machInst, uint8_t rowIdx,
            std::shared_ptr<RiscvISA::MatStoreState> state);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(
            PacketPtr, ExecContext *, trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr, const loader::SymbolTable *) const override;

      private:
        RegId srcRegIdxArr[3];
        RegId destRegIdxArr[1];
        const uint8_t rowIdx;
        const std::shared_ptr<RiscvISA::MatStoreState> state;
    };
}};

def template MatrixStoreRowMicroConstructor {{
    %(class_name)s::%(class_name)s(
        ExtMachInst machInst, uint8_t rowIdx,
        std::shared_ptr<RiscvISA::MatStoreState> state)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s),
          rowIdx(rowIdx), state(std::move(state))
    {
        setRegIdxArrays(
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
        setSrcRegIdx(_numSrcRegs++, matRegClass[MREG]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[machInst.rs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[machInst.rs2]);
        memAccessFlags = (Request::Flags)(%(mem_align)s);
        flags[IsStore] = true;
        flags[IsMatrix] = true;
        flags[IsInteger] = true;
    }
}};

def template MatrixStoreRowMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        if (!state->initialized) {
            RiscvISA::MatRegContainer tile;
            xc->getRegOperand(this, 0, &tile);
            for (std::size_t row = 0; row < RiscvISA::MatRowCount; ++row) {
                state->rows[row] = serializeMatRowBytes(tile, row);
            }
            state->initialized = true;
        }

        const auto base = xc->getRegOperand(this, 1);
        const auto stride = xc->getRegOperand(this, 2);
        const Addr ea = rvSext(base + rowIdx * stride);
        static const std::vector<bool> byte_enable(
            RiscvISA::MatRowByteCount, true);
        return xc->writeMem(
            const_cast<uint8_t *>(state->rows[rowIdx].data()),
            RiscvISA::MatRowByteCount, ea, memAccessFlags, nullptr,
            byte_enable);
    }

    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        if (!state->initialized) {
            RiscvISA::MatRegContainer tile;
            xc->getRegOperand(this, 0, &tile);
            for (std::size_t row = 0; row < RiscvISA::MatRowCount; ++row) {
                state->rows[row] = serializeMatRowBytes(tile, row);
            }
            state->initialized = true;
        }

        const auto base = xc->getRegOperand(this, 1);
        const auto stride = xc->getRegOperand(this, 2);
        const Addr ea = rvSext(base + rowIdx * stride);
        static const std::vector<bool> byte_enable(
            RiscvISA::MatRowByteCount, true);
        return xc->writeMem(
            const_cast<uint8_t *>(state->rows[rowIdx].data()),
            RiscvISA::MatRowByteCount, ea, memAccessFlags, nullptr,
            byte_enable);
    }

    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        return mnemonic;
    }
}};

def format MatrixOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, opt_flags)
    header_output = MatrixDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MatrixExecute.subst(iop)
}};

def format MatrixLoadMacro(mem_align, *opt_flags) {{
    microop_setup = '''
        auto state = std::make_shared<RiscvISA::MatLoadState>();
        for (uint8_t row = 0; row < RiscvISA::MatRowCount; ++row) {
            cur_inst = new %(micro_class)s(
                machInst, row, state, row + 1 == RiscvISA::MatRowCount);
            if (row + 1 != RiscvISA::MatRowCount) {
                cur_inst->setDelayedCommit();
            }
            microops.emplace_back(cur_inst);
        }
    ''' % {'micro_class': f'{Name}RowMicro'}

    macro_iop = InstObjParams(
        name, Name, 'RiscvMacroInst',
        {'microop_setup': microop_setup}, opt_flags)
    header_output = MatrixMacroDeclare.subst(macro_iop)
    decoder_output = MatrixMacroConstructor.subst(macro_iop)
    decode_block = BasicDecode.subst(macro_iop)
    exec_output = ''

    micro_iop = InstObjParams(
        f'{name}_row', f'{Name}RowMicro', 'Load',
        {'mem_align': mem_align}, opt_flags)
    header_output += MatrixLoadRowMicroDeclare.subst(micro_iop)
    decoder_output += MatrixLoadRowMicroConstructor.subst(micro_iop)
    exec_output += MatrixLoadRowMicroExecute.subst(micro_iop)
}};

def format MatrixStoreMacro(mem_align, *opt_flags) {{
    microop_setup = '''
        auto state = std::make_shared<RiscvISA::MatStoreState>();
        for (uint8_t row = 0; row < RiscvISA::MatRowCount; ++row) {
            cur_inst = new %(micro_class)s(machInst, row, state);
            if (row + 1 != RiscvISA::MatRowCount) {
                cur_inst->setDelayedCommit();
            }
            microops.emplace_back(cur_inst);
        }
    ''' % {'micro_class': f'{Name}RowMicro'}

    macro_iop = InstObjParams(
        name, Name, 'RiscvMacroInst',
        {'microop_setup': microop_setup}, opt_flags)
    header_output = MatrixMacroDeclare.subst(macro_iop)
    decoder_output = MatrixMacroConstructor.subst(macro_iop)
    decode_block = BasicDecode.subst(macro_iop)
    exec_output = ''

    micro_iop = InstObjParams(
        f'{name}_row', f'{Name}RowMicro', 'Store',
        {'mem_align': mem_align}, opt_flags)
    header_output += MatrixStoreRowMicroDeclare.subst(micro_iop)
    decoder_output += MatrixStoreRowMicroConstructor.subst(micro_iop)
    exec_output += MatrixStoreRowMicroExecute.subst(micro_iop)
}};
